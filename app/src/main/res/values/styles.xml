<resources>

    <!-- Material 3 base theme. Overrides the BaseAppTheme shipped by CommonUtils. -->
    <style name="BaseAppTheme" parent="Theme.Material3.DayNight">
        <item name="colorPrimary">@color/m3_primary</item>
        <item name="colorOnPrimary">@color/m3_on_primary</item>
        <item name="colorPrimaryContainer">@color/m3_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/m3_on_primary_container</item>
        <item name="colorSecondary">@color/m3_secondary</item>
        <item name="colorOnSecondary">@color/m3_on_secondary</item>
        <item name="colorSecondaryContainer">@color/m3_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/m3_on_secondary_container</item>
        <item name="colorTertiary">@color/m3_tertiary</item>
        <item name="colorOnTertiary">@color/m3_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/m3_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/m3_on_tertiary_container</item>
        <item name="android:colorBackground">@color/m3_background</item>
        <item name="colorSurface">@color/m3_surface</item>
        <item name="colorOnSurface">@color/m3_on_surface</item>
        <item name="colorSurfaceVariant">@color/m3_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/m3_on_surface_variant</item>

        <!-- Backward compatibility for CommonUtils and older layouts -->
        <item name="colorPrimaryVariant">?attr/colorPrimaryContainer</item>
        <item name="colorPrimaryDark">?attr/colorPrimaryContainer</item>
        <item name="colorSecondaryVariant">?attr/colorSecondaryContainer</item>
        <item name="colorAccent">?attr/colorSecondary</item>
    </style>

    <style name="AppTheme" parent="BaseAppTheme" />

    <style name="AppTheme.FullBlackNight" parent="AppTheme" />

    <!-- Force white -->
    <style name="ForceWhite">
        <item name="android:tint">@color/white</item>
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColorSecondary">@color/white</item>
    </style>

    <!-- Edit profile TextInputField -->
    <style name="DarkTextInputLayout.OutlinedBox.Dense" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense">
        <item name="boxStrokeColor">@color/text_field_stroke_on_dark</item>
        <item name="endIconTint">@color/white</item>
        <item name="errorTextColor">@color/red</item>
        <item name="helperTextTextColor">@color/white</item>
        <item name="hintTextColor">@color/colorSecondary</item>
        <item name="android:textColorHint">@color/white</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textCursorDrawable">@null</item>
    </style>

    <!-- Edit profile CheckBox -->
    <style name="DarkCheckBox" parent="Widget.MaterialComponents.CompoundButton.CheckBox" />

    <!-- App theme variants -->
    <style name="AppTheme.NoActionBar.Uri" parent="AppTheme.NoActionBar" />

    <style name="AppTheme.NoActionBar.Torrent" parent="AppTheme.NoActionBar">
        <item name="colorPrimary">@color/colorTorrent</item>
        <item name="colorPrimaryVariant">@color/colorTorrentVariant</item>
        <item name="colorSecondary">@color/colorTorrent</item>
        <item name="colorSecondaryVariant">@color/colorTorrentVariant</item>
        <item name="colorOnPrimary">#fff</item>
        <item name="colorOnSecondary">#fff</item>
        <item name="android:statusBarColor">@color/colorTorrentVariant</item>
    </style>

    <style name="AppTheme.NoActionBar.Metalink" parent="AppTheme.NoActionBar">
        <item name="colorPrimary">@color/colorMetalink</item>
        <item name="colorPrimaryVariant">@color/colorMetalinkVariant</item>
        <item name="colorSecondary">@color/colorMetalink</item>
        <item name="colorSecondaryVariant">@color/colorMetalinkVariant</item>
        <item name="colorOnPrimary">#fff</item>
        <item name="colorOnSecondary">#fff</item>
        <item name="android:statusBarColor">@color/colorMetalinkVariant</item>
    </style>

    <style name="AppTheme.NoActionBar.WebView" parent="AppTheme.NoActionBar">
        <item name="colorPrimary">@color/colorWebView</item>
        <item name="colorPrimaryVariant">@color/colorWebViewPressed</item>
        <item name="colorSecondary">@color/colorWebView</item>
        <item name="colorSecondaryVariant">@color/colorWebViewPressed</item>
        <item name="colorOnPrimary">#fff</item>
        <item name="colorOnSecondary">#fff</item>
        <item name="android:statusBarColor">@color/colorWebViewPressed</item>
    </style>

    <style name="AppTheme.Batch" parent="AppTheme.Batch.Default" />

    <style name="AppTheme.Batch.Default" parent="AppTheme">
        <item name="colorPrimary">@color/colorBatch</item>
        <item name="colorPrimaryVariant">@color/colorBatchVariant</item>
        <item name="colorSecondary">@color/colorBatch</item>
        <item name="colorSecondaryVariant">@color/colorBatchVariant</item>
        <item name="colorOnPrimary">#fff</item>
        <item name="colorOnSecondary">#fff</item>
        <item name="android:statusBarColor">@color/colorBatchVariant</item>
    </style>

    <style name="AppTheme.Search" parent="AppTheme.Search.Default" />

    <style name="AppTheme.Search.Default" parent="AppTheme">
        <item name="colorPrimary">@color/colorSearch</item>
        <item name="colorPrimaryVariant">@color/colorSearchVariant</item>
        <item name="colorSecondary">@color/colorSearch</item>
        <item name="colorSecondaryVariant">@color/colorSearchVariant</item>
        <item name="colorOnPrimary">#fff</item>
        <item name="colorOnSecondary">#fff</item>
        <item name="android:statusBarColor">@color/colorSearchVariant</item>
    </style>

    <!-- Fab label style -->
    <style name="FabLabel">
        <item name="android:background">@drawable/fab_label_layout</item>
        <item name="android:textColor">?colorSurface</item>
    </style>

    <!-- Big layout tabbing -->
    <style name="BigTabLayout" parent="Widget.MaterialComponents.TabLayout.Colored">
        <item name="tabMode">scrollable</item>
    </style>

    <!-- Custom style for FileTypeTextView -->
    <declare-styleable name="FileTypeTextView">
        <attr name="textColor" format="color" />
        <attr name="maxHeight" format="dimension" />
    </declare-styleable>
</resources>
